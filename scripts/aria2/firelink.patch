+#include <algorithm>
@@ -64,0 +66 @@ Request::Request()
+      routeResolvedPort_(0),
@@ -86,0 +89 @@ bool Request::setUri(const std::string& uri)
+  clearRouteResolvedAddresses();
@@ -93,0 +97 @@ bool Request::resetUri()
